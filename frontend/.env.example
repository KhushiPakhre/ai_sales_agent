# Copy to .env.local (Vite auto-loads it).

# Base path the frontend calls for API requests. Left as the default "/api"
# and proxied to the backend during `npm run dev` (see vite.config.js) - only
# override this if you're pointing at a deployed backend on a different origin.
# VITE_API_BASE_URL=/api

# Where the Vite dev server proxy forwards /api requests to.
VITE_API_PROXY_TARGET=http://localhost:8000
