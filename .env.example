# Copy to .env and adjust as needed. The backend reads these via os.environ
# (no python-dotenv dependency added - export them in your shell, or use
# `env $(cat .env | xargs) uvicorn backend.app:app` / your process manager's
# built-in .env support).

# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to the Vite dev server if unset.
QDESQ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional - enables the LLM-augmented extraction pass in agent/extractor.py.
# Leave unset to run entirely on the heuristic extractor (no external calls).
# ANTHROPIC_API_KEY=
